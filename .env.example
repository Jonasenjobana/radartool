HOST=127.0.0.1
PORT=3100
# 本地 SQLite 数据库目录，文件名为 radar-tool.sqlite。
DATA_DIR=./data
# 配置真实项目时取消注释；凭据只放本机 .env 或部署环境。
# PROJECT_CONFIG=./config/projects.json
# CLICKHOUSE_URL=http://127.0.0.1:8123
# CLICKHOUSE_USER=readonly
# CLICKHOUSE_PASSWORD=
# AIS_API_URL=http://127.0.0.1:8080/structured-ais-history
# AIS_AUTHORIZATION=Bearer replace-locally
# 直接读取原始 AIS 报文时先运行 npm run setup:ais-parser；可指定 Java/JDK 路径。
# JAVA_BIN=C:/Program Files/Java/jdk1.8.0_151/bin/java.exe
# JAVAC_BIN=C:/Program Files/Java/jdk1.8.0_151/bin/javac.exe
