{
  "name": "radar-ais-calibration-tool",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0 <23"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:server": "node --watch --env-file-if-exists=.env server/index.js",
    "dev:client": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "setup:ais-parser": "node scripts/setup-ais-parser.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js"
  },
  "dependencies": {
    "@clickhouse/client": "^1.12.0",
    "@element-plus/icons-vue": "2.3.2",
    "@fastify/static": "10.1.10",
    "element-plus": "2.14.8",
    "fastify": "5.12.8",
    "leaflet": "1.9.4",
    "vue": "3.5.45",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "@vitejs/plugin-vue": "6.0.10",
    "typescript": "5.9.3",
    "vite": "8.3.7",
    "vue-tsc": "3.3.14"
  }
}
